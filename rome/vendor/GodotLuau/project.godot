; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodotLuau"
config/features=PackedStringArray("4.7")
boot_splash/image="res://GodotLuau/icons/GodotLuauSplash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="res://GodotLuau/icons/GodotLuauIcono.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotLuauUpdater/plugin.cfg")

[physics]

common/max_physics_steps_per_frame=1
3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/temporary_memory_buffer_size=128
jolt_physics_3d/limits/max_bodies=262144
jolt_physics_3d/limits/max_body_pairs=131072
jolt_physics_3d/limits/max_contact_constraints=40960

[rendering]

rendering_device/d3d12/max_resource_descriptors=131072
